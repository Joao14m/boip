rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /listings/{userId}/{lotId}/{slot} {
      allow read: if true;
      // Owner-only writes, constrained to images (<10MB) or videos (<100MB).
      // Rejects oversized and non-media uploads to prevent abuse of the public bucket.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024)
        );
    }
  }
}
